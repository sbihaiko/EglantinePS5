+namespace {
+// Open IOFiles by stream, for ReportOpenFiles (a file-handle leak shows as one place growing).
+std::mutex& OpenFilesMutex() {
+    static std::mutex mutex;
+    return mutex;
+}
+std::unordered_map<std::FILE*, std::string>& OpenFiles() {
+    static std::unordered_map<std::FILE*, std::string> files;
+    return files;
+}
+} // namespace
+
+void ReportOpenFiles(std::FILE* out) {
+    std::map<std::string, size_t> folders;
+    size_t total = 0;
+    {
+        std::scoped_lock lock{OpenFilesMutex()};
+        total = OpenFiles().size();
+        for (const auto& [stream, path] : OpenFiles()) {
+            const auto slash = path.find_last_of('/');
+            ++folders[slash == std::string::npos ? path : path.substr(0, slash)];
+        }
+    }
+    std::vector<std::pair<size_t, std::string>> largest;
+    for (auto& [folder, count] : folders) largest.emplace_back(count, folder);
+    std::sort(largest.rbegin(), largest.rend());
+    std::fprintf(out, "EDEN_OPEN_FILES iofile=%zu folders=%zu", total, folders.size());
+    for (size_t i = 0; i < largest.size() && i < 6; ++i)
+        std::fprintf(out, " | %zu %s", largest[i].first, largest[i].second.c_str());
+    std::fprintf(out, "\n");
+}
