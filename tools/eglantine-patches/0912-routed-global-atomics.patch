 /// compute a slightly different position and reject the colour pass in spots, which shows the
 /// bright sky through holes that bloom then blows up. Read once.
 [[nodiscard]] bool PositionInvariant();
+/// EDEN_NX2_GLOBAL_ATOMICS=1: 32-bit global atomics the storage buffer pass could not route
+/// run on the bound storage buffer that holds their address (port of the fork's old 0065).
+[[nodiscard]] bool GlobalAtomics();
 
 static std::bitset<8> clip_distance_written;
 
@@ -378,6 +381,23 @@ public:
 
     Id write_storage_cas_loop_func{};
 
+    enum class GlobalAtomic : size_t {
+        IAdd,
+        SMin,
+        UMin,
+        SMax,
+        UMax,
+        Inc,
+        Dec,
+        And,
+        Or,
+        Xor,
+        Exchange,
+        AddF32,
+        Count,
+    };
+    std::array<Id, static_cast<size_t>(GlobalAtomic::Count)> global_atomic_funcs{};
+
     Id load_global_func_u32{};
     Id load_global_func_u32x2{};
     Id load_global_func_u32x4{};
@@ -462,7 +482,7 @@ private:
     void DefineImages(const Info& info, u32& binding, u32& scaling_index);
     void DefineAttributeMemAccess(const Info& info);
     void DefineWriteStorageCasLoopFunction(const Info& info);
-    void DefineGlobalMemoryFunctions(const Info& info);
+    void DefineGlobalMemoryFunctions(const IR::Program& program);
     void DefineRescalingInput(const Info& info);
     void DefineRescalingInputPushConstant();
     void DefineRescalingInputUniformConstant();
