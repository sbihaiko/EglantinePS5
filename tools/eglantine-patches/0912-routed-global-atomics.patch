+/// A 32-bit global atomic through its routing function (DefineGlobalMemoryFunctions). With
+/// EDEN_NX2_GLOBAL_ATOMICS off no function exists and the instruction stays unimplemented.
+Id GlobalAtomic(EmitContext& ctx, EmitContext::GlobalAtomic kind, Id type,
+                const IR::Value& address, Id value, const char* name) {
+    const Id function{ctx.global_atomic_funcs[static_cast<size_t>(kind)]};
+    if (!Sirit::ValidId(function)) {
+        throw NotImplementedException("SPIR-V Instruction {}", name);
+    }
+    return ctx.OpFunctionCall(type, function, ctx.Def(address), value);
+}
 } // Anonymous namespace
 
