+namespace {
+/// EDEN_NX2_VMA_STATS=1: the allocator's device memory blocks, which is what the PS5 pool is made
+/// of, and what was asked of them. The emulator's own allocators report their own memory; this is
+/// the layer below, where a block is taken from the system without saying who wanted it.
+bool VmaStatsEnabled() {
+    static const bool on{[] {
+        const char* const value{std::getenv("EDEN_NX2_VMA_STATS")};
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }()};
+    return on;
+}
+
+constexpr VkDeviceSize VmaStatsMinBytes = VkDeviceSize{16} << 20;
+
+void VmaStatsBlock(const char* what, uint32_t memory_type, VkDeviceMemory memory, VkDeviceSize size) {
+    if (size < VmaStatsMinBytes || !VmaStatsEnabled()) {
+        return;
+    }
+    std::fprintf(stderr, "eden vma-stats %s type=%u size=%llu MiB memory=0x%llx\n", what, memory_type,
+                 static_cast<unsigned long long>(size >> 20),
+                 static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(memory)));
+}
+
+void VmaAllocateCallback(VmaAllocator, uint32_t memory_type, VkDeviceMemory memory, VkDeviceSize size,
+                         void*) {
+    VmaStatsBlock("block-new", memory_type, memory, size);
+}
+
+void VmaFreeCallback(VmaAllocator, uint32_t memory_type, VkDeviceMemory memory, VkDeviceSize size,
+                     void*) {
+    VmaStatsBlock("block-gone", memory_type, memory, size);
+}
+
+const VmaDeviceMemoryCallbacks* AllocatorCallbacks() {
+    static const VmaDeviceMemoryCallbacks callbacks{
+        .pfnAllocate = &VmaAllocateCallback,
+        .pfnFree = &VmaFreeCallback,
+        .pUserData = nullptr,
+    };
+    return VmaStatsEnabled() ? &callbacks : nullptr;
+}
+} // Anonymous namespace
+
     const VmaAllocatorCreateInfo allocator_info{
             .flags = flags,
             .physicalDevice = physical,
@@ -788,7 +832,7 @@ Device::Device(VkInstance instance_, vk::PhysicalDevice physical_, VkSurfaceKHR
                 return static_cast<VkDeviceSize>(mib >= 4 && mib <= 256 ? mib : 64) * 1024u * 1024u;
             }(),
             .pAllocationCallbacks = nullptr,
-            .pDeviceMemoryCallbacks = nullptr,
+            .pDeviceMemoryCallbacks = AllocatorCallbacks(),
             .pHeapSizeLimit = heap_size_limit != 0 ? heap_size_limits.data() : nullptr,
             .pVulkanFunctions = &functions,
             .instance = instance,
@@ -1924,4 +1968,21 @@ void Device::ShutdownGPULogging() {
