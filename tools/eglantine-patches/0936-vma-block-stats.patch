 }
 
+void Device::DumpAllocatorStats() const {
+    if (allocator == nullptr || !VmaStatsEnabled()) {
+        return;
+    }
+    VmaTotalStatistics stats{};
+    vmaCalculateStatistics(allocator, &stats);
+    const VmaStatistics& total = stats.total.statistics;
+    const VkDeviceSize unused = total.blockBytes > total.allocationBytes
+                                    ? total.blockBytes - total.allocationBytes
+                                    : VkDeviceSize{0};
+    std::fprintf(stderr,
+                 "eden vma-stats total blocks=%u blockMiB=%llu allocs=%u allocMiB=%llu unused=%llu MiB\n",
+                 total.blockCount, static_cast<unsigned long long>(total.blockBytes >> 20),
+                 total.allocationCount, static_cast<unsigned long long>(total.allocationBytes >> 20),
+                 static_cast<unsigned long long>(unused >> 20));
+}
+
 } // namespace Vulkan
