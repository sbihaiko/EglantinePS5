+// transitions it from VK_IMAGE_LAYOUT_UNDEFINED, so a recycled one behaves the same.
+struct ImageRecyclePool {
+    struct Key {
+        std::vector<u32> words;
+        bool operator==(const Key&) const = default;
+    };
+    struct Entry {
+        Key key;
+        VkImage image;
+        VmaAllocation allocation;
+        u64 size;
