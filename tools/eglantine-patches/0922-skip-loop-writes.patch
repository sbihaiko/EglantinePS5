From d9542fd63ea2c7e3603561d8b0da7894e5a725dc Mon Sep 17 00:00:00 2001
From: sbihaiko <bihaiko@protonmail.com>
Date: Wed, 11 Nov 2026 11:08:42 -0300
Subject: [PATCH] maxwell_3d: the split front drops instance-loop writes the
 back ignores, with EDEN_NX2_SKIP_LOOP_WRITES=1

With macros on the split's front, the front sends every write to the back.
Ocarina of Time sends about 520,000 draw.end and 390,000 same-value
vertex_buffer.count writes a second that the back ignores: DrawEnd draws
nothing in DrawMode::Instance, and the draw manager only reads the vertex
buffer's first and count. With the switch the front tracks the instance loop
from the value the back acts on and drops those writes (index_buffer writes
still go, since they mark the index buffer dirty). It keeps them while state
writes wait in the back's method sink, which only a lone state write outside
a macro leaves there on this tree (Regs and CbData blocks consume it), so a
deferred draw still issues before the next engine's work. This tree's
DrawArrayInstanced sets DrawMode::General, so vertex_array_instance_first
and _subsequent also leave the loop in the front's copy. Measured by Lichii:
Kokiri porch 28.8 -> 30.6 FPS (+6%, PC), back-thread methods 3.49 M -> 3.07
M a second.

Lichii #488's restart handling (copying the front again after the split
stops and starts) is left out: this tree never releases the front, so the
existing same-value skip already has that gap, and Ocarina of Time does not
stop the split during play.

Off by default; with the switch unset nothing is dropped.
Port of Lichii #178 (7e2a9fe20) with #488 (5ba52f772).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/video_core/engines/maxwell_3d.cpp | 85 +++++++++++++++++++++++++++
 src/video_core/engines/maxwell_3d.h   |  2 +
 2 files changed, 87 insertions(+)

diff --git a/src/video_core/engines/maxwell_3d.cpp b/src/video_core/engines/maxwell_3d.cpp
index 8ce5750..f0a6290 100644
--- a/src/video_core/engines/maxwell_3d.cpp
+++ b/src/video_core/engines/maxwell_3d.cpp
@@ -1022,6 +1022,12 @@ struct Maxwell3D::FrontState {
     /// then can it have a deferred instanced draw to issue at the end of a macro.
     bool draw_pending{true};
     bool skip_same{}; ///< SkipSameValueWrites() && FrontSkipSame(), read once
+    bool skip_loop{}; ///< FrontSkipLoopWrites() (EDEN_NX2_SKIP_LOOP_WRITES=1), read once
+    /// The back's draw manager is in an instance loop (DrawMode::Instance): draw.end does nothing.
+    bool instance_loop{};
+    /// The back holds state writes in its method sink, which its next executable method consumes
+    /// (issuing a deferred draw a changed one ends). Front() consumes it before copying the state.
+    bool sink_pending{};
     /// MME DMA read sources (address space and GPU address): how many drains after a wait for
     /// idle in a row found nothing new there, or -1 once one did (FrontDmaRead,
     /// EDEN_NX2_DMA_READ_TRUST=1).
@@ -1079,6 +1085,16 @@ bool FrontSkipSame() {
     return skip;
 }
 
+// EDEN_NX2_SKIP_LOOP_WRITES=1 (Lichii #178 with #488): the front drops draw.end inside an
+// instance loop and same-value vertex_buffer.first and .count writes (FrontSkipsLoopWrite).
+bool FrontSkipLoopWrites() {
+    static const bool skip = [] {
+        const char* value = std::getenv("EDEN_NX2_SKIP_LOOP_WRITES");
+        return value != nullptr && value[0] != '0';
+    }();
+    return skip;
+}
+
 } // Anonymous namespace
 
 Maxwell3D::FrontState& Maxwell3D::Front(Core::System& system, VideoCommon::GpuSplit& split) {
@@ -1092,6 +1108,7 @@ Maxwell3D::FrontState& Maxwell3D::Front(Core::System& system, VideoCommon::GpuSp
         std::memcpy(front->shadow.data(), shadow_state.reg_array.data(), sizeof(front->shadow));
         front->control = shadow_state.shadow_ram_control;
         front->skip_same = SkipSameValueWrites() && FrontSkipSame();
+        front->skip_loop = front->skip_same && FrontSkipLoopWrites();
         front->executing_macro = executing_macro;
         front->parameters = std::move(macro_params);
         macro_params.clear();
@@ -1123,6 +1140,12 @@ void Maxwell3D::FrontWrite(VideoCommon::GpuSplit& split, FrontState& fs, u32 met
         fs.control_writes[fs.control_count++ % fs.control_writes.size()] = {
             argument, static_cast<u32>(fs.control), from_macro ? 2U : 1U};
     }
+    if (fs.skip_loop && execution_mask[method] && FrontSkipsLoopWrite(fs, method, value, shadow_kept)) {
+        if (Profile::Enabled()) [[unlikely]] {
+            Profile::Add(Profile::Counter::SameValueWrites, 1);
+        }
+        return;
+    }
     if (!execution_mask[method]) {
         // Nothing would change on the back: CallMethod and ConsumeSinkImpl skip same-value state
         // writes, and the shadow RAM (tracked by default) holds the value already.
@@ -1186,14 +1209,20 @@ void Maxwell3D::FrontWrite(VideoCommon::GpuSplit& split, FrontState& fs, u32 met
         }
     }
     constexpr u32 cb_data_first = MAXWELL3D_REG_INDEX(const_buffer.buffer);
+    // sink_pending (EDEN_NX2_SKIP_LOOP_WRITES): Regs and CbData blocks and macro writes (Direct)
+    // consume the back's sink, as an executable method does; a lone state write stays in it.
     if (!execution_mask[method] && split.RegBlocks()) {
         split.PlainWrite(this, method, argument);
+        fs.sink_pending = false;
     } else if (method >= cb_data_first && method < cb_data_first + 16 && split.RegBlocks()) {
         split.CbDataWrite(this, method, argument);
+        fs.sink_pending = false;
     } else if (from_macro) {
         split.MacroWrite(this, method, argument);
+        fs.sink_pending = false;
     } else {
         split.Method(this, method, argument, is_last_call, nullptr);
+        fs.sink_pending = !execution_mask[method];
     }
     if (report_write) [[unlikely]] {
         Regs::ReportSemaphore report;
@@ -1251,6 +1280,9 @@ void Maxwell3D::FrontCallMultiMethod(Core::System& system, VideoCommon::GpuSplit
                 method == MAXWELL3D_REG_INDEX(inline_index_2x16.even) ||
                 method == MAXWELL3D_REG_INDEX(inline_index_4x8.index0)) &&
                fs.control != Regs::ShadowRamControl::Replay) {
+        if (fs.skip_loop) {
+            FrontTrackInstanceLoop(fs, method, 0);
+        }
         if (amount != 0) {
             const u32 last = base_start[amount - 1];
             if (tracked()) {
@@ -1275,6 +1307,9 @@ void Maxwell3D::FrontCallMultiMethod(Core::System& system, VideoCommon::GpuSplit
                 value = fs.shadow[method];
             }
             fs.regs[method] = value;
+            if (fs.skip_loop) {
+                FrontTrackInstanceLoop(fs, method, value); // DrawBegin runs for every word
+            }
             if (!execution_mask[method]) {
                 continue;
             }
@@ -1310,6 +1345,56 @@ void Maxwell3D::FrontCallMultiMethod(Core::System& system, VideoCommon::GpuSplit
         }
     }
     split.MultiMethod(this, method, base_start, amount, methods_pending, nullptr);
+    fs.sink_pending = false; // The back consumes the sink before a run.
+}
+
+// EDEN_NX2_SKIP_LOOP_WRITES=1 (Lichii #178): follows the back's DrawMode as the draw manager sets
+// it, from the value the back acts on (the shadow word in Replay mode).
+void Maxwell3D::FrontTrackInstanceLoop(FrontState& fs, u32 method, u32 value) {
+    switch (method) {
+    case MAXWELL3D_REG_INDEX(draw.begin):
+        // Instance id, bits 27:26: First leaves an instance loop, Subsequent enters one.
+        if (((value >> 26) & 3) == 0) {
+            fs.instance_loop = false;
+        } else if (((value >> 26) & 3) == 1) {
+            fs.instance_loop = true;
+        }
+        break;
+    case MAXWELL3D_REG_INDEX(draw_inline_index):
+    case MAXWELL3D_REG_INDEX(inline_index_2x16.even):
+    case MAXWELL3D_REG_INDEX(inline_index_4x8.index0):
+        fs.instance_loop = false; // DrawMode::InlineIndex: draw.end draws
+        break;
+    case MAXWELL3D_REG_INDEX(vertex_array_instance_first):
+    case MAXWELL3D_REG_INDEX(vertex_array_instance_subsequent):
+        fs.instance_loop = false; // DrawArrayInstanced sets DrawMode::General on this tree
+        break;
+    default:
+        break;
+    }
+}
+
+bool Maxwell3D::FrontSkipsLoopWrite(FrontState& fs, u32 method, u32 value, bool shadow_kept) {
+    FrontTrackInstanceLoop(fs, method, value);
+    switch (method) {
+    case MAXWELL3D_REG_INDEX(draw.end):
+    case MAXWELL3D_REG_INDEX(vertex_buffer.first):
+    case MAXWELL3D_REG_INDEX(vertex_buffer.count):
+        break;
+    default:
+        return false;
+    }
+    // Sent while state writes wait in the back's sink (Lichii #488): it consumes them at the next
+    // executable method, and a changed one ends a deferred draw that must issue before the next
+    // engine's work (a compute dispatch after a dropped vertex_buffer.count would otherwise run
+    // first).
+    if (!fs.skip_same || fs.sink_pending || !shadow_kept || fs.regs[method] != value) {
+        return false;
+    }
+    // Instance loop methods flush no deferred draw, and the draw manager ignores these: DrawEnd
+    // draws nothing in an instance loop, and it only reads the vertex buffer first and count
+    // (index_buffer writes also mark the index buffer dirty, so they are always sent).
+    return method != MAXWELL3D_REG_INDEX(draw.end) || fs.instance_loop;
 }
 
 void Maxwell3D::FrontRunMacro(Core::System& system, VideoCommon::GpuSplit& split,
diff --git a/src/video_core/engines/maxwell_3d.h b/src/video_core/engines/maxwell_3d.h
index b3030f6..3394a76 100644
--- a/src/video_core/engines/maxwell_3d.h
+++ b/src/video_core/engines/maxwell_3d.h
@@ -3394,6 +3394,8 @@ private:
     void FrontWrite(VideoCommon::GpuSplit& split, FrontState& state, u32 method, u32 argument,
                     bool is_last_call, bool from_macro);
     void FrontRunMacro(Core::System& system, VideoCommon::GpuSplit& split, FrontState& state);
+    void FrontTrackInstanceLoop(FrontState& state, u32 method, u32 value);
+    bool FrontSkipsLoopWrite(FrontState& state, u32 method, u32 value, bool shadow_kept);
     void FrontDmaRead(VideoCommon::GpuSplit& split, FrontState& state, u32 method, u32 count);
     void FrontVerify(VideoCommon::GpuSplit& split, FrontState& state);
     void FinishFrontMacro(Core::System& system);
-- 
