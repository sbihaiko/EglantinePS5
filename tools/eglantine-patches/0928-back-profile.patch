diff --git a/src/common/stall_ledger.h b/src/common/stall_ledger.h
index cf1dd46c84..36857b2db1 100644
--- a/src/common/stall_ledger.h
+++ b/src/common/stall_ledger.h
@@ -175,4 +175,65 @@ struct AudioGap {
     return true;
 }
 
+
+// EDEN_NX2_BACK_PROFILE=1: where the split's back thread was when the front waited. The back sets
+// its phase as it works (Execute: running ring entries, Submit: a queue submission, FenceWait: a
+// wait for a GPU tick); the EDEN_STALL line reads it, so a stall says whether the back was idle,
+// submitting or waiting on the GPU while the front waited seconds.
+enum class BackPhase : std::uint32_t { Idle, Execute, Submit, FenceWait, Alloc, Count };
+
+inline thread_local bool on_back_thread = false;
+inline std::atomic<std::uint32_t> back_phase{static_cast<std::uint32_t>(BackPhase::Idle)};
+inline std::atomic<std::uint64_t> back_phase_ns{0};
+
+[[nodiscard]] inline bool BackProfileEnabled() {
+    static const bool on = [] {
+        const char* const value = std::getenv("EDEN_NX2_BACK_PROFILE");
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    return on;
+}
+
+[[nodiscard]] inline std::uint64_t BackNowNs() {
+    return static_cast<std::uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now().time_since_epoch()).count());
+}
+
+inline void EnterBackPhase(BackPhase phase) {
+    if (!BackProfileEnabled() || !on_back_thread) return;
+    back_phase_ns.store(BackNowNs(), std::memory_order_relaxed);
+    back_phase.store(static_cast<std::uint32_t>(phase), std::memory_order_relaxed);
+}
+
+inline void SetBackThread(bool on) {
+    on_back_thread = on;
+    if (!on) EnterBackPhase(BackPhase::Idle);
+}
+
+[[nodiscard]] inline const char* BackPhaseName(std::uint32_t phase) {
+    switch (static_cast<BackPhase>(phase)) {
+    case BackPhase::Idle: return "idle";
+    case BackPhase::Execute: return "execute";
+    case BackPhase::Submit: return "submit";
+    case BackPhase::FenceWait: return "fence";
+    case BackPhase::Alloc: return "alloc";
+    default: return "?";
+    }
+}
+
+[[nodiscard]] inline double BackPhaseMs() {
+    const std::uint64_t at = back_phase_ns.load(std::memory_order_relaxed);
+    return at == 0 ? 0.0 : static_cast<double>(BackNowNs() - at) / 1e6;
+}
+
+struct BackPhaseScope {
+    BackPhase saved;
+    explicit BackPhaseScope(BackPhase next) : saved{static_cast<BackPhase>(back_phase.load(std::memory_order_relaxed))} {
+        EnterBackPhase(next);
+    }
+    ~BackPhaseScope() { EnterBackPhase(saved); }
+    BackPhaseScope(const BackPhaseScope&) = delete;
+    BackPhaseScope& operator=(const BackPhaseScope&) = delete;
+};
+
 } // namespace Common::StallLedger
