-    const u32 dimension = GENERATE(0U, 1U, 2U, 5U);
-    const u32 mask = GENERATE(1U, 3U, 9U, 7U, 15U);
-    const u32 nodep = GENERATE(0U, 1U);
-    const u32 count = static_cast<u32>(std::popcount(mask));
-    const u32 second = count > 2 ? 20U : 255U;
