+
+bool ImageCounters() {
+    static const bool on = [] {
+        const char* const value{std::getenv("EDEN_NX2_IMAGE_COUNTERS")};
+        return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }();
+    return on;
+}
+
+void CountCreated(ImageRecyclePool& pool, u64 size) {
+    ++pool.created;
+    const u64 mib = size >> 20;
+    const size_t bucket = mib < 2 ? 0 : mib < 4 ? 1 : mib < 8 ? 2 : mib < 16 ? 3 : mib < 32 ? 4 : 5;
+    ++pool.bucket[bucket];
+}
+
+/// Every 30 s: what was created by size, and why the pool did not answer.
+void ReportImageCounters(ImageRecyclePool& pool) {
+    if (!ImageCounters()) {
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (now - pool.last_counters < std::chrono::seconds{30}) {
+        return;
+    }
+    pool.last_counters = now;
+    LOG_INFO(Render_Vulkan,
+             "Image counters: created {} (<2 {} 2-4 {} 4-8 {} 8-16 {} 16-32 {} >=32 {}), "
+             "not recyclable {}, under 4 MiB {}, no match {}, recycled {}, kept {}, evicted {}, "
+             "{} MiB held",
+             pool.created, pool.bucket[0], pool.bucket[1], pool.bucket[2], pool.bucket[3],
+             pool.bucket[4], pool.bucket[5], pool.not_keyed, pool.below_floor, pool.no_match,
+             pool.hits, pool.kept, pool.evicted, pool.held >> 20);
+}
 } // namespace
 
