+namespace {
+// The recovery the allocator calls when it is out of device memory (EDEN_NX2_MEMORY_RECOVERY).
+// It reads and frees the texture cache runtime's state, which only the GPU thread touches, so it
+// answers no from any other thread.
+std::function<bool(int)> eden_recover_graphics_memory;
+std::atomic<std::thread::id> eden_recover_graphics_memory_owner{};
+bool EdenRecoverGraphicsMemory(int attempt) {
+    if (std::this_thread::get_id() !=
+            eden_recover_graphics_memory_owner.load(std::memory_order_acquire) ||
+        !eden_recover_graphics_memory) {
+        return false;
+    }
+    return eden_recover_graphics_memory(attempt);
+}
+} // Anonymous namespace
+
 void TextureCacheRuntime::TickFrame() {
+    // EDEN_NX2_MEMORY_RECOVERY=1 (mihawk 0234): the allocator, out of device memory, asks the
+    // renderer to give back what it can before it ends the session. From the second attempt on the
+    // GPU thread first finishes what it submitted, so everything the cache keeps for reuse is idle
+    // and can go: decode copies, staging buffers, and the scratch images kept for the next frame.
+    if (static const bool recovery = [] {
+            const char* const value = std::getenv("EDEN_NX2_MEMORY_RECOVERY");
+            return value != nullptr && value[0] == '1' && value[1] == '\0';
+        }();
+        recovery && !VideoCommon::HostPool::RecoveryInstalled()) {
+        eden_recover_graphics_memory = [this](int attempt) {
+            if (attempt >= 1) {
+                scheduler.Finish();
+            }
+            while (!pending_transcodes.empty() &&
+                   scheduler.IsFree(pending_transcodes.front().tick)) {
+                pending_transcodes.pop_front();
+            }
+            std::erase_if(msaa_scratch_images, [this](MsaaScratchImage& scratch) {
+                return scheduler.IsFree(scratch.tick);
+            });
+            std::erase_if(pending_resolve_shadows,
+                          [this](const auto& pending) { return scheduler.IsFree(pending.first); });
+            staging_buffer_pool.ReleaseCached();
+            return true;
+        };
+        eden_recover_graphics_memory_owner.store(std::this_thread::get_id(),
+                                                 std::memory_order_release);
+        VideoCommon::HostPool::SetRecoverQuery(&EdenRecoverGraphicsMemory);
+    }
     while (!pending_transcodes.empty() && scheduler.IsFree(pending_transcodes.front().tick)) {
         pending_transcodes.pop_front();
     }
