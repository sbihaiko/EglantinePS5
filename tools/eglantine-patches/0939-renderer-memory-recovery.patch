+size_t StagingBufferPool::ReleaseCached() {
+    // One ReleaseLevel pass drops up to sixteen entries at its level; a pass over every level for
+    // every level size clears the cache however full it is.
+    const auto size_of = [this] {
+        size_t total = 0;
+        for (const MemoryUsage usage :
+             {MemoryUsage::DeviceLocal, MemoryUsage::Upload, MemoryUsage::Download}) {
+            for (const auto& buffers : GetCache(usage)) {
+                total += buffers.entries.size();
+            }
+        }
+        return total;
+    };
+    const size_t before = size_of();
+    for (size_t pass = 0; pass < NUM_LEVELS; ++pass) {
+        for (size_t level = 0; level < NUM_LEVELS; ++level) {
+            ReleaseLevel(GetCache(MemoryUsage::DeviceLocal), level);
+            ReleaseLevel(GetCache(MemoryUsage::Upload), level);
+            ReleaseLevel(GetCache(MemoryUsage::Download), level);
+        }
+        if (size_of() == 0) {
+            break;
+        }
+    }
+    return before - size_of();
+}
+
 void StagingBufferPool::ReleaseCache(MemoryUsage usage) {
     ReleaseLevel(GetCache(usage), current_delete_level);
 }
