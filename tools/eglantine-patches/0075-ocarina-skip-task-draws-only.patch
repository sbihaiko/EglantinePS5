@@ -564,12 +564,13 @@ void RasterizerVulkan::PrepareDraw(bool is_indexed, Func&& draw_func) {
         report_failure("no VK_EXT_mesh_shader");
         return;
     }
-    if (mesh_draw && VideoCommon::OotNetwork::SkipMeshDraws(Settings::GetCurrentProgramID())) {
-        // Ocarina of Time's vegetation: its task programs read what compute programs that do not
-        // build yet would have written (oot_network.h).
+    if (mesh_draw && VideoCommon::OotNetwork::SkipMeshDraw(Settings::GetCurrentProgramID(),
+                                                            pipeline->HasTaskStage())) {
+        // Ocarina of Time's vegetation: its task program reads instance records through pointers
+        // the storage buffer tracking does not bind for graphics stages yet (oot_network.h).
         static bool logged = false;
         if (!std::exchange(logged, true)) {
-            LOG_INFO(Render_Vulkan, "Ocarina of Time: task/mesh draws are skipped (EDEN_OOT_MESH_DRAWS=draw issues them)");
+            LOG_INFO(Render_Vulkan, "Ocarina of Time: task draws are skipped (EDEN_OOT_MESH_DRAWS=draw issues them)");
         }
         return;
     }
