 }
 
+Id Module::OpCoopMatrixLoadNV(Id result_type, Id pointer, Id stride, Id column_major) {
+    code->Reserve(6);
+    return *code << OpId{static_cast<spv::Op>(5359u), result_type} << pointer << stride
+                 << column_major << EndOp{};
+}
+
+void Module::OpCoopMatrixStoreNV(Id pointer, Id matrix, Id stride, Id column_major) {
+    code->Reserve(5);
+    *code << static_cast<spv::Op>(5360u) << pointer << matrix << stride << column_major << EndOp{};
+}
+
+Id Module::OpCoopMatrixMulAddNV(Id result_type, Id matrix_a, Id matrix_b, Id matrix_c) {
+    code->Reserve(6);
+    return *code << OpId{static_cast<spv::Op>(5361u), result_type} << matrix_a << matrix_b
+                 << matrix_c << EndOp{};
+}
+
 } // namespace Sirit
